pkgname=lyre
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal music player"
arch=(x86_64)
license=(LicenseRef-Unknown)
depends=(
  glibc
  gcc-libs
  gstreamer
  gst-plugins-base
  gst-plugins-good
  yt-dlp
  ffmpeg
)
makedepends=(cargo)
options=(!strip)

prepare() {
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  # Copy the working tree into the makepkg sandbox, item by item.
  # Copying "$startdir/.." directly fails: packaging/ is inside the tree,
  # so that would copy a directory into itself.
  (shopt -s dotglob nullglob
   cd "$startdir/.."
   for item in *; do
     [ "$item" = packaging ] && continue
     cp -r "$item" "$srcdir/$pkgname"/
   done)
  cd "$srcdir/$pkgname"
  rm -rf .git target

  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
}

build() {
  cd "$srcdir/$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

check() {
  cd "$srcdir/$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked
}

package() {
  install -Dm755 "$srcdir/target/release/lyre" "$pkgdir/usr/bin/lyre"

  # Example themes ship as documentation, not config.
  local theme_dir="$pkgdir/usr/share/doc/lyre/themes"
  install -dm755 "$theme_dir"
  install -Dm644 "$srcdir/$pkgname/theme.example.toml" "$theme_dir/theme.example.toml"
  install -Dm644 "$srcdir/$pkgname"/themes/*.toml "$theme_dir/"
}
